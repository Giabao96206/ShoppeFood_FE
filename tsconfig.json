{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "components/*": ["src/components/*"],
      "utils/*": ["src/utils/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "globals.d.ts",
    "axios.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "src/components/example/restaurant/main.tsx_"
  ]
}
